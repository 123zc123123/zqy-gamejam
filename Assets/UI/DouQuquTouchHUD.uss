/* 占位外观对齐 prototype-v5/style.css #stick。正式图走 DouQuquStickTheme 的 Sprite 槽。 */
.touch-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    picking-mode: Position;
}

.stick-base {
    position: absolute;
    left: 50%;
    bottom: 24px;
    width: 128px;
    height: 128px;
    margin-left: -64px;
    background-color: rgba(14, 16, 14, 0.58);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(196, 165, 116, 0.40);
    border-right-color: rgba(196, 165, 116, 0.40);
    border-top-color: rgba(196, 165, 116, 0.40);
    border-bottom-color: rgba(196, 165, 116, 0.40);
    border-radius: 64px;
    picking-mode: Ignore;
    display: none;
}

.stick-center {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    background-color: rgb(239, 230, 210);
    border-radius: 5px;
    picking-mode: Ignore;
}

.stick-knob {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 52px;
    height: 52px;
    margin-left: -26px;
    margin-top: -26px;
    background-color: rgb(138, 74, 58);
    border-radius: 26px;
    picking-mode: Ignore;
}

.stick-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    color: rgba(232, 220, 196, 0.55);
    -unity-font-size: 11px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    picking-mode: Ignore;
}
