.merge-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(8, 16, 28);
    align-items: center;
    justify-content: center;
    picking-mode: Position;
}

.merge-root {
    width: 420px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 22px;
    padding-bottom: 18px;
    background-color: rgba(10, 22, 40, 0.96);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(125, 205, 255, 0.82);
    border-right-color: rgba(125, 205, 255, 0.82);
    border-top-color: rgba(125, 205, 255, 0.82);
    border-bottom-color: rgba(125, 205, 255, 0.82);
    border-radius: 22px;
    align-items: center;
    picking-mode: Position;
}

.merge-title {
    width: 100%;
    color: rgb(235, 248, 255);
    -unity-font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.merge-score {
    width: 100%;
    color: rgb(174, 222, 255);
    -unity-font-size: 22px;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.merge-draw {
    width: 100%;
    min-height: 34px;
    margin-bottom: 10px;
    color: rgba(255, 231, 164, 0.96);
    -unity-font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.merge-board {
    width: 324px;
    height: 324px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-left: 4px;
    padding-top: 4px;
    background-color: rgba(52, 84, 119, 0.52);
    border-radius: 12px;
}

.merge-cell {
    width: 76px;
    height: 76px;
    margin-right: 4px;
    margin-bottom: 4px;
    background-color: rgba(26, 46, 69, 0.92);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(145, 193, 226, 0.30);
    border-right-color: rgba(145, 193, 226, 0.30);
    border-top-color: rgba(145, 193, 226, 0.30);
    border-bottom-color: rgba(145, 193, 226, 0.30);
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    picking-mode: Position;
}

.merge-cell.merge-dragging {
    border-left-color: rgb(255, 245, 167);
    border-right-color: rgb(255, 245, 167);
    border-top-color: rgb(255, 245, 167);
    border-bottom-color: rgb(255, 245, 167);
}

.merge-cell.merge-target {
    border-left-color: rgb(130, 242, 190);
    border-right-color: rgb(130, 242, 190);
    border-top-color: rgb(130, 242, 190);
    border-bottom-color: rgb(130, 242, 190);
}

.merge-cell-label {
    width: 100%;
    height: 100%;
    color: rgb(15, 29, 48);
    -unity-font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-overflow-position: Ellipsis;
    picking-mode: Ignore;
}

.merge-spawn-button {
    width: 240px;
    height: 48px;
    margin-top: 16px;
    background-color: rgb(75, 178, 231);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-radius: 10px;
    color: rgb(8, 25, 42);
    -unity-font-size: 21px;
    -unity-font-style: bold;
}

.merge-spawn-button:hover {
    background-color: rgb(116, 211, 255);
}

.merge-status {
    width: 100%;
    min-height: 44px;
    margin-top: 8px;
    color: rgba(225, 240, 255, 0.88);
    -unity-font-size: 16px;
    -unity-text-align: middle-center;
    white-space: normal;
}
