<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/DouQuquMergeHUD.uss" />
    <ui:VisualElement name="merge-screen" class="merge-screen">
        <ui:VisualElement name="merge-root" class="merge-root">
            <ui:Label name="merge-title" text="育虫盘" class="merge-title" />
            <ui:Label name="merge-score-label" text="分数 0" class="merge-score" />
            <ui:Label name="merge-draw-label" text="合到三级后生成蟋蟀并从棋盘消失：A 40/30/25/5，B 各 25%" class="merge-draw" />
            <ui:VisualElement name="merge-board" class="merge-board">
                <ui:VisualElement name="merge-cell-0" class="merge-cell"><ui:Label name="merge-cell-label-0" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-1" class="merge-cell"><ui:Label name="merge-cell-label-1" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-2" class="merge-cell"><ui:Label name="merge-cell-label-2" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-3" class="merge-cell"><ui:Label name="merge-cell-label-3" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-4" class="merge-cell"><ui:Label name="merge-cell-label-4" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-5" class="merge-cell"><ui:Label name="merge-cell-label-5" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-6" class="merge-cell"><ui:Label name="merge-cell-label-6" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-7" class="merge-cell"><ui:Label name="merge-cell-label-7" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-8" class="merge-cell"><ui:Label name="merge-cell-label-8" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-9" class="merge-cell"><ui:Label name="merge-cell-label-9" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-10" class="merge-cell"><ui:Label name="merge-cell-label-10" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-11" class="merge-cell"><ui:Label name="merge-cell-label-11" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-12" class="merge-cell"><ui:Label name="merge-cell-label-12" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-13" class="merge-cell"><ui:Label name="merge-cell-label-13" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-14" class="merge-cell"><ui:Label name="merge-cell-label-14" text="" class="merge-cell-label" /></ui:VisualElement>
                <ui:VisualElement name="merge-cell-15" class="merge-cell"><ui:Label name="merge-cell-label-15" text="" class="merge-cell-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="merge-spawn-button" text="获得合成道具" class="merge-spawn-button" />
            <ui:Label name="merge-status-label" text="点击按钮获得棋子，再拖动棋子合成" class="merge-status" />
            <ui:Button name="merge-back-button" text="返回主界面" class="merge-back-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
