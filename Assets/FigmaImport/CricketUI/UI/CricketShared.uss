
.cricket-screen {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    color: rgb(247, 239, 215);
    background-color: rgb(220, 214, 193);
    background-image: url("../Textures/village-background.png");
    -unity-background-scale-mode: scale-and-crop;
}

.profile-card {
    position: absolute;
    left: 40px;
    top: 40px;
    width: 245px;
    height: 104px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(79, 78, 70, 0.88);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(207, 159, 64);
    border-right-color: rgb(207, 159, 64);
    border-top-color: rgb(207, 159, 64);
    border-bottom-color: rgb(207, 159, 64);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.profile-portrait {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    margin-right: 12px;
    border-top-left-radius: 40px;
    border-top-right-radius: 40px;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    background-image: url("../Textures/player-profile.png");
    -unity-background-scale-mode: scale-to-fit;
}

.profile-copy {
    flex-grow: 1;
    height: 72px;
    justify-content: center;
}

.profile-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(250, 247, 237);
}

.profile-stat {
    margin-top: 5px;
    flex-direction: row;
    align-items: center;
}

.profile-stat-icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    background-image: url("../Textures/hud-swords.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.profile-power {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(229, 196, 143);
}

.resource-hud {
    position: absolute;
    left: 891px;
    top: 43px;
    width: 149px;
    height: 98px;
    align-items: stretch;
}

.resource-row {
    width: 149px;
    height: 40px;
    padding-left: 13px;
    padding-right: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(74, 75, 70, 0.9);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.resource-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    background-image: url("../Textures/hud-coins.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.resource-value {
    flex-grow: 1;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(250, 247, 237);
    -unity-text-align: middle-left;
}

.event-row {
    width: 149px;
    height: 44px;
    margin-top: 8px;
    padding-left: 13px;
    padding-right: 12px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(161, 31, 35);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.event-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 246, 225);
}

.event-time {
    margin-left: 6px;
    font-size: 14px;
    color: rgb(244, 206, 145);
}

.utility-entry {
    position: absolute;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(30, 25, 20, 0.9);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(185, 132, 39);
    border-right-color: rgb(185, 132, 39);
    border-top-color: rgb(185, 132, 39);
    border-bottom-color: rgb(185, 132, 39);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.festival-entry {
    left: 65px;
    top: 238px;
    width: 84px;
    height: 53px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(248, 240, 219);
}

.cage-entry {
    left: 899px;
    top: 238px;
    width: 85px;
    height: 80px;
}

.cage-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(229, 196, 143);
    -unity-text-align: middle-center;
}

.cage-subtitle {
    margin-top: 5px;
    font-size: 12px;
    color: rgb(241, 234, 215);
    -unity-text-align: middle-center;
}

.side-rail {
    position: absolute;
    left: 40px;
    top: 340px;
    width: 96px;
    height: 520px;
    justify-content: space-between;
}

.side-item {
    width: 96px;
    height: 92px;
    align-items: center;
}

.side-button {
    width: 64px;
    height: 64px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(37, 24, 20);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(205, 153, 57);
    border-right-color: rgb(205, 153, 57);
    border-top-color: rgb(205, 153, 57);
    border-bottom-color: rgb(205, 153, 57);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}

.side-button:hover {
    background-color: rgb(61, 41, 31);
}

.side-icon {
    width: 28px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.side-gift .side-icon { background-image: url("../Textures/sidebar-gift.svg"); }
.side-shop .side-icon { background-image: url("../Textures/sidebar-shop.svg"); }
.side-trophy .side-icon { background-image: url("../Textures/sidebar-trophy.svg"); }
.side-swords .side-icon { background-image: url("../Textures/sidebar-swords.svg"); }
.side-share .side-icon { background-image: url("../Textures/sidebar-share.svg"); }

.side-label {
    margin-top: 3px;
    font-size: 14px;
    color: rgb(250, 247, 238);
    -unity-text-align: middle-center;
}

.map-entry {
    position: absolute;
    height: 94px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(24, 20, 16, 0.78);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.map-entry:hover {
    background-color: rgba(45, 35, 24, 0.9);
}

.map-title {
    font-size: 43px;
    -unity-font-style: bold;
    color: rgb(229, 196, 143);
    -unity-text-align: middle-center;
}

.arena-entry {
    left: 601px;
    top: 1030px;
    width: 156px;
}

.collection-entry {
    left: 857px;
    top: 1328px;
    width: 171px;
}

.collection-entry .map-title {
    font-size: 40px;
}

.training-entry {
    left: 282px;
    top: 1536px;
    width: 175px;
    height: 86px;
}

.bottom-action {
    position: absolute;
    left: 0;
    top: 1770px;
    width: 150px;
    height: 150px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-image: url("../Textures/bottom-ellipse.svg");
    -unity-background-scale-mode: scale-to-fit;
}

.bottom-action:hover {
    -unity-background-image-tint-color: rgb(235, 218, 137);
}

.bottom-arrow {
    margin-top: -10px;
    font-size: 105px;
    -unity-font-style: bold;
    color: rgb(83, 95, 15);
    -unity-text-align: middle-center;
}
