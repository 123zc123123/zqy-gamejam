
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/FigmaImport/CricketUI/UI/CricketShared.uss" />
    <ui:VisualElement name="CricketHomepage" class="cricket-screen">
        <ui:VisualElement name="PlayerProfile" class="profile-card">
            <ui:VisualElement name="Portrait" class="profile-portrait" />
            <ui:VisualElement class="profile-copy">
                <ui:Label name="PlayerName" text="蟋蟀爱好者" class="profile-name" />
                <ui:VisualElement class="profile-stat">
                    <ui:VisualElement class="profile-stat-icon" />
                    <ui:Label name="PlayerPower" text="最强战力 1303" class="profile-power" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ResourceHud" class="resource-hud">
            <ui:VisualElement name="Coins" class="resource-row">
                <ui:VisualElement class="resource-icon" />
                <ui:Label text="18,450" class="resource-value" />
            </ui:VisualElement>
            <ui:VisualElement name="Attendance" class="event-row">
                <ui:Label text="七日点卯" class="event-name" />
                <ui:Label text="01:07" class="event-time" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="FestivalButton" text="蟋蟀祭" class="utility-entry festival-entry" />
        <ui:Button name="CageButton" text="" class="utility-entry cage-entry">
            <ui:Label text="草笼棚" class="cage-title" />
            <ui:Label text="养精蓄锐" class="cage-subtitle" />
        </ui:Button>

        <ui:VisualElement name="Sidebar" class="side-rail">
            <ui:VisualElement class="side-item">
                <ui:Button name="GiftButton" text="" tooltip="幸运抽宝" class="side-button side-gift"><ui:VisualElement class="side-icon" /></ui:Button>
                <ui:Label text="幸运抽宝" class="side-label" />
            </ui:VisualElement>
            <ui:VisualElement class="side-item">
                <ui:Button name="ShopButton" text="" tooltip="精品在线" class="side-button side-shop"><ui:VisualElement class="side-icon" /></ui:Button>
                <ui:Label text="精品在线" class="side-label" />
            </ui:VisualElement>
            <ui:VisualElement class="side-item">
                <ui:Button name="RankButton" text="" tooltip="蟋蟀千争霸" class="side-button side-trophy"><ui:VisualElement class="side-icon" /></ui:Button>
                <ui:Label text="蟋蟀千争霸" class="side-label" />
            </ui:VisualElement>
            <ui:VisualElement class="side-item">
                <ui:Button name="BattleButton" text="" tooltip="战力交换" class="side-button side-swords"><ui:VisualElement class="side-icon" /></ui:Button>
                <ui:Label text="战力交换" class="side-label" />
            </ui:VisualElement>
            <ui:VisualElement class="side-item">
                <ui:Button name="ShareButton" text="" tooltip="分享" class="side-button side-share"><ui:VisualElement class="side-icon" /></ui:Button>
                <ui:Label text="分享" class="side-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="ArenaButton" text="" tooltip="角斗场" class="map-entry arena-entry">
            <ui:Label text="角斗场" class="map-title" />
        </ui:Button>
        <ui:Button name="CollectionButton" text="" tooltip="收藏谱" class="map-entry collection-entry">
            <ui:Label text="收藏谱" class="map-title" />
        </ui:Button>
        <ui:Button name="TrainingButton" text="" tooltip="培养室" class="map-entry training-entry">
            <ui:Label text="培养室" class="map-title" />
        </ui:Button>

        <ui:Button name="EnterButton" text="" tooltip="进入" class="bottom-action">
            <ui:Label text="→" class="bottom-arrow" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>
